# ==============================================================================
# Challenges Center Registration Platform - Environment Variables
# ==============================================================================

# Session & Token Cryptographic Signing Key (Generate with: openssl rand -base64 32)
ADMIN_SESSION_SECRET=replace-with-a-secure-random-32-byte-secret-key

# Admin Authentication credentials (for initial bootstrap/fallback access)
ADMIN_DEFAULT_EMAIL=admin@challengescenter.dz
ADMIN_DEFAULT_PASSWORD=ChangeThisToAStrongPassword2026!

# Supabase Configuration (Optional - for persistent production storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
