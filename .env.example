# ==============================================================================
# Challenges Center Registration Platform - Environment Variables
# ==============================================================================

# Supabase Configuration
# Client-side (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only (Admin / elevated privileges - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin Authentication credentials (for initial bootstrap/fallback access)
ADMIN_DEFAULT_EMAIL=admin@challengescenter.dz
ADMIN_DEFAULT_PASSWORD=ChallengesCenter2026!

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
